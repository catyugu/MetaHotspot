@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Eigen3 5 CONFIG)
find_dependency(spdlog 1.17 CONFIG)
find_dependency(tinyxml2 11 CONFIG)
if(@MHS_NEEDS_OPENMP@)
    find_dependency(OpenMP COMPONENTS CXX)
endif()
find_dependency(muparser 2.3.5 CONFIG)
find_dependency(TBB 2023 CONFIG)
if(@MHS_ENABLE_PARDISO@)
    find_dependency(MKL CONFIG)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/MetaHotspotTargets.cmake")
check_required_components(MetaHotspot)
